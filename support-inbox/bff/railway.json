{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "RUNTIME_ENV": "prd",
    "DATABASE_URL": "${{support-inbox-db.DATABASE_URL}}",
    "AGENTOS_BASE_URL": "http://${{agent-os.RAILWAY_PRIVATE_DOMAIN}}:8000",
    "SUPPORT_ALLOWED_ORIGINS": "https://support.example.com",
    "SUPPORT_COOKIE_SECURE": "true"
  }
}
